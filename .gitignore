# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
.claude/
data/site-content.json
data/*.db
data/*.db-shm
data/*.db-wal
data/wp-import.json

# user-uploaded product images (served at /uploads)
/public/uploads/
# product photos migrated off WordPress (served at /catalog)
/public/catalog/

# server-side runtime artefacts (VPS working tree)
/.next-old/
/.next-build/
/deploy-safe.log
/import-sources.log
# licensed font supplied on the server, not redistributable via this public repo
/public/fonts/
# stock/catalog spreadsheets dropped in for one-off imports
/scripts/*.xls
/scripts/*.xlsx
/scripts/*.csv
