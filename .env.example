# Скопіюйте у .env.local і заповніть. Сам .env.local у git не потрапляє —
# репозиторій публічний, і будь-який ключ звідси одразу став би загальним.

# ── Обов'язкове ───────────────────────────────────────────────────────────
# Без бази застосунок не підніметься: вітрина читає товари з PostgreSQL.
# Схема створюється сама при першому запиті, міграцій запускати не треба.
DATABASE_URL=postgresql://user:password@localhost:5432/maniagroup

# ── Адмінка (обов'язкове на проді) ────────────────────────────────────────
ADMIN_PASSWORD=
# openssl rand -hex 32 — підпис сесійної куки. Без нього кука підписується
# публічним значенням із коду, і її можна підробити, не знаючи пароля.
ADMIN_SECRET=
# Нестандартний шлях панелі, щоб її не знаходили перебором. /admin віддає 404.
NEXT_PUBLIC_ADMIN_PATH=admin

# ── Необов'язкове ─────────────────────────────────────────────────────────
# Канонічна адреса: canonical, OG, sitemap. Дефолт — бойовий домен.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 вмикає індексацію пошуковиками. Порожньо = сайт закритий у robots.txt.
SITE_INDEXABLE=
# Відділення Нової Пошти й розрахунок доставки.
NOVAPOSHTA_API_KEY=
# Автозавантаження логотипів брендів.
LOGO_DEV_TOKEN=
# AI-помічник в адмінці й розбір імпортних файлів.
OPENROUTER_API_KEY=
